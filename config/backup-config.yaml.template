# ==============================================================================
# Template de Configuracion - Sistema de Backup InfluxDB Enterprise
# ==============================================================================
# Sistema de backup distribuido con procesamiento paralelo por campo
#
# Caracteristicas tecnicas:
#   - Arquitectura field-by-field con aislamiento de datos
#   - Paralelizacion configurable mediante ThreadPoolExecutor
#   - Prevencion de contaminacion cruzada entre campos
#   - Gestion de timestamps especificos por campo
#   - Logging thread-safe con identificadores unicos
#   - Soporte para backup incremental y por rangos
#
# Guia de implementacion:
# 1. Copia este template: cp backup-config.yaml.template empresa_backup.yaml
# 2. Configura los parametros segun el entorno de produccion
# 3. Valida la configuracion: python main.py --validate-only
# 4. Ejecuta el proceso: python main.py --config /config
#
# ==============================================================================

# ==============================================================================
# Configuracion del servidor InfluxDB origen
# ==============================================================================
source:
  # Endpoint del servidor InfluxDB fuente (requerido)
  #
  # Formatos soportados:
  # - Contenedor Docker: http://nombre-contenedor:8086
  # - Instancia local: http://localhost:8086
  # - Servidor remoto: http://ip-servidor:8086
  #
  # Ejemplos de configuracion:
  # url: http://production-influxdb:8086     # Servidor de produccion
  # url: http://monitoring-influx:8086       # Servidor de monitoreo
  url: http://source-influxdb:8086

  # Configuracion de bases de datos
  # ===============================
  # Opcion A: Backup de bases de datos especificas
  # Define explicitamente las bases de datos a respaldar
  databases:
    - name: production_metrics    # Base de datos origen
      destination: metrics_backup # Base de datos destino
    - name: application_logs
      destination: logs_backup

  # Opcion B: Backup automatico de todas las bases de datos
  # Utiliza lista vacia para procesar todas las BD disponibles:
  # databases: []

  # Convenciones de nomenclatura
  # ============================
  # Sistema de prefijos y sufijos para identificacion de backups
  #
  # Ejemplos de uso:
  # prefix: "backup_"    → metrics se convierte en backup_metrics
  # suffix: "_archive"   → metrics se convierte en metrics_archive
  # prefix: "prod_", suffix: "_v2" → metrics se convierte en prod_metrics_v2
  prefix: ""
  suffix: ""

  # Configuracion de autenticacion
  # ==============================
  # Credenciales para el servidor InfluxDB origen
  # Dejar vacio si el servidor no requiere autenticacion
  #
  # Configuracion con autenticacion:
  # user: "backup_service"
  # password: "secure_password_123"
  user: ""
  password: ""

  # Optimizacion de consultas
  # ==========================
  # Controla la agregacion temporal de datos en las consultas
  #
  # Valores de configuracion:
  # - "30s": Agregacion cada 30 segundos (alta frecuencia, menor memoria)
  # - "1m":  Agregacion por minuto (balance optimo)
  # - "5m":  Agregacion cada 5 minutos (menor frecuencia, mayor memoria)
  # - "1h":  Agregacion horaria (datos historicos extensos)
  # - "":    Sin agregacion (datasets pequenos)
  #
  # Recomendaciones por caso de uso:
  # - Datos en tiempo real: "30s" o "1m"
  # - Backups historicos: "5m" o "1h"
  # - Datasets reducidos: "" (sin agregacion)
  group_by: ""

# ==============================================================================
# Configuracion del servidor InfluxDB destino
# ==============================================================================
destination:
  # Endpoint del servidor InfluxDB de destino (requerido)
  # Puede ser la misma instancia que el origen utilizando diferentes bases de datos
  #
  # Ejemplos de configuracion:
  # url: http://backup-server:8086           # Servidor dedicado para backups
  # url: http://dr-influxdb:8086             # Servidor de disaster recovery
  # url: http://archive-storage:8086         # Almacenamiento de archivo
  url: http://destination-influxdb:8086

  # Autenticacion para el servidor destino
  # Puede diferir de las credenciales del servidor origen
  user: ""
  password: ""

# Sistema de filtrado de mediciones
# =================================
measurements:
  # Estrategia de inclusion (recomendada)
  # Procesa unicamente las mediciones especificadas
  include: []
  # Ejemplo: include: [cpu_metrics, memory_stats, network_io, disk_usage]

  # Estrategia de exclusion
  # Procesa todas las mediciones excepto las especificadas
  exclude: []
  # Ejemplo: exclude: [debug_traces, temporary_logs, test_data]
  #
  # Nota: No utilizar include y exclude simultaneamente

  # Configuraciones especificas por medicion
  # =======================================
  # Define el procesamiento detallado para mediciones individuales
  # Implementa la funcionalidad core de procesamiento field-by-field
  # Para configuracion basica sin procesamiento especifico, utilizar lista vacia
  specific: []
    # Ejemplos de configuracion avanzada:
    #
    # Configuracion para metricas de CPU
    # ==================================
    # cpu_metrics:
    #   fields:
    #     # Campos especificos a procesar
    #     include: [usage_user, usage_system, usage_idle, usage_iowait]
    #     exclude: []
    #     # Tipos de datos soportados
    #     types: [numeric, string, boolean]
    #
    # Configuracion para metricas de memoria
    # ======================================
    # memory_stats:
    #   fields:
    #     include: []  # Procesar todos los campos disponibles
    #     # Excluir campos de cache volatiles
    #     exclude: [buffer_cache, page_cache, slab_cache]
    #     types: [numeric, string]
    #
    # Configuracion para datos meteorologicos
    # =======================================
    # weather_data:
    #   fields:
    #     # Procesamiento field-by-field de sensores especificos
    #     include: [temperature_2m, humidity_relative, wind_speed_10m]
    #     exclude: []
    #     types: [numeric, string, boolean]
    #
    # Configuracion para multiples sensores en paralelo
    # =================================================
    # sensor_station:
    #   fields:
    #     # Cada campo se procesa en thread independiente
    #     include: [
    #       temperature,      # Worker T01
    #       humidity,         # Worker T02
    #       pressure,         # Worker T03
    #       wind_speed,       # Worker T04
    #       wind_direction,   # Worker T05
    #       precipitation,    # Worker T06
    #       solar_radiation,  # Worker T07
    #       uv_index         # Worker T08
    #     ]
    #     exclude: []
    #     types: [numeric]

# ==============================================================================
# Configuracion de backup y paralelizacion
# ==============================================================================
options:
  # Modalidades de backup
  # =====================
  #
  # incremental: Backup diferencial desde la ultima ejecucion
  # - Casos de uso: Backups continuos, sincronizacion en tiempo real
  # - Metodo: Utiliza timestamps especificos por campo para evitar duplicados
  # - Ejecucion: Segun cronograma configurado
  #
  # range: Backup de periodo especifico
  # - Casos de uso: Migraciones historicas, backups puntuales
  # - Metodo: Fechas de inicio y fin definidas
  # - Ejecucion: Proceso unico hasta completar el rango
  backup_mode: incremental

  # Configuracion para modo range
  # =============================
  # Aplicable unicamente cuando backup_mode = "range"
  range:
    # Fechas en formato ISO 8601 (YYYY-MM-DDTHH:MM:SSZ)
    #
    # Configuracion para ano completo:
    # start_date: "2023-01-01T00:00:00Z"
    # end_date: "2023-12-31T23:59:59Z"
    #
    # Configuracion para periodo especifico:
    # start_date: "2023-11-01T00:00:00Z"
    # end_date: "2023-11-30T23:59:59Z"
    start_date: ""
    end_date: ""

  # Configuracion para modo incremental
  # ===================================
  # Aplicable unicamente cuando backup_mode = "incremental"
  incremental:
    # Expresion CRON para automatizacion de ejecuciones
    # Dejar vacio para ejecucion unica manual
    #
    # Patrones de configuracion estandar:
    # "* * * * *"        # Cada minuto (entorno de desarrollo)
    # "*/15 * * * *"     # Cada 15 minutos (alta frecuencia)
    # "0 * * * *"        # Cada hora (frecuencia estandar)
    # "0 */6 * * *"      # Cada 6 horas (frecuencia reducida)
    # "0 2 * * *"        # Diario a las 02:00 (backup nocturno)
    # "0 2 * * 0"        # Semanal los domingos a las 02:00
    # "0 1 1 * *"        # Mensual el primer dia a las 01:00
    #
    # Formato: "minuto hora dia_mes mes dia_semana"
    schedule: ""

  # Configuracion de red y conectividad
  # ===================================
  # Parametros de timeout y politica de reintentos
  timeout_client: 20                    # Timeout por consulta (segundos)
  retries: 3                           # Numero de reintentos por operacion
  retry_delay: 5                       # Intervalo entre reintentos (segundos)
  initial_connection_retry_delay: 60   # Retraso para reconexion inicial

  # Sistema de paginacion
  # =====================
  # Segmentacion de consultas extensas para optimizacion de memoria
  #
  # Guia de configuracion por tamano de base de datos:
  # - 1 dia: Bases de datos enterprise (>100GB)
  # - 7 dias: Bases de datos medianas (10-100GB)
  # - 30 dias: Bases de datos pequenas (<10GB)
  days_of_pagination: 7

  # Sistema de paralelizacion avanzada
  # ==================================
  # Configuracion del procesamiento concurrente field-by-field
  #
  # Arquitectura del sistema:
  # - Procesamiento independiente por campo mediante ThreadPoolExecutor
  # - Timestamps especificos por campo (eliminacion de contaminacion cruzada)
  # - Gestion automatica de concurrencia
  # - Logging con identificadores unicos por thread ([T01], [T02], etc.)
  #
  # Matriz de configuracion recomendada:
  #
  # ┌─────────────────┬──────────────────┬─────────────────────────────────┐
  # │ Campos a backup │ parallel_workers │ Descripcion del escenario       │
  # ├─────────────────┼──────────────────┼─────────────────────────────────┤
  # │ 1 campo         │ 1                │ Secuencial (maxima estabilidad) │
  # │ 2-4 campos      │ 2-4              │ Paralelizacion completa         │
  # │ 5-8 campos      │ 4-6              │ Balance rendimiento/recursos    │
  # │ 9+ campos       │ 6-8              │ Alto rendimiento                │
  # │ Hardware robusto│ 8-16             │ Paralelizacion intensiva        │
  # └─────────────────┴──────────────────┴─────────────────────────────────┘
  #
  # Ejemplos de configuracion por escenario:
  #
  # Escenario A: Campo critico unico
  # parallel_workers: 1
  # measurements.specific.critical_sensor.fields.include: [reactor_temperature]
  #
  # Escenario B: Estacion meteorologica (8 sensores)
  # parallel_workers: 8
  # measurements.specific.weather.fields.include: [temp, humidity, pressure, ...]
  #
  # Escenario C: Multiples mediciones con campos diversos
  # parallel_workers: 4  # Configuracion equilibrada
  #
  # Consideraciones tecnicas:
  # - No exceder el numero de CPU cores disponibles
  # - Monitorear consumo de memoria con configuraciones intensivas
  # - Utilizar parallel_workers: 1 para validacion inicial
  parallel_workers: 1

  # Gestion de campos obsoletos
  # ===========================
  # Filtrado automatico de campos sin actividad reciente
  #
  # Formato de configuracion: numero + unidad temporal (s, m, h, d, w, M, y)
  # Ejemplos de configuracion:
  # "30d"  - Ignorar campos inactivos por 30 dias
  # "6M"   - Ignorar campos inactivos por 6 meses
  # "1y"   - Ignorar campos inactivos por 1 ano
  # ""     - Procesar todos los campos (sin filtrado)
  #
  # Configuracion recomendada: "6M" para entornos de produccion
  field_obsolete_threshold: "1y"

# ============================================================================
# Sistema de logging y auditoria
# ============================================================================
logging:
  # Configuracion del directorio de logs
  # Debe coincidir con los volumenes definidos en docker-compose.yaml
  log_directory: /var/log/backup_influxdb/

  # Sistema de rotacion automatica de logs
  log_rotation:
    enabled: true
    when: 'D'        # D=diario, H=horario, M=por minuto
    interval: 1      # Frecuencia de rotacion
    backup_count: 7  # Archivos historicos a mantener

  # Integracion con Loki (logging centralizado)
  loki:
    enabled: false
    url: "backup-loki"
    port: 3100
    # Tags para identificacion unica de configuraciones. Se pueden agregar
    # tantos tags como se desee
    tags:
      app: "backup-influxdb"
      config: "my_backup.yaml"

  # Niveles de logging disponibles
  # DEBUG: Informacion detallada (entorno de desarrollo)
  # INFO: Informacion estandar (entorno de produccion recomendado)
  # WARNING: Advertencias y errores unicamente
  # ERROR: Errores criticos unicamente
  log_level: INFO

